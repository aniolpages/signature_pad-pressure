{
  "name": "@aniolpages/signature-pad-pressure",
  "description": "Library for drawing smooth signatures.",
  "version": "5.1.4-pressure.5",
  "homepage": "https://github.com/aniolpages/signature_pad-pressure",
  "author": {
    "name": "Szymon Nowak",
    "email": "szimek@gmail.com",
    "url": "https://github.com/szimek"
  },
  "license": "MIT",
  "source": "src/signature_pad.ts",
  "main": "dist/signature_pad.cjs",
  "module": "dist/signature_pad.js",
  "type": "module",
  "types": "dist/types/signature_pad.d.ts",
  "exports": {
    "types": "./dist/types/signature_pad.d.ts",
    "import": "./dist/signature_pad.js",
    "require": "./dist/signature_pad.cjs",
    "default": "./dist/signature_pad.umd.js"
  },
  "scripts": {
    "build": "npm run lint && npm run clean && node esbuild.config.js && npm run emit-types && npm run update-docs && npm run test:package",
    "clean": "del dist",
    "emit-types": "del dist/types && tsc src/signature_pad.ts --lib DOM,ES2015 --declaration --declarationDir dist/types --emitDeclarationOnly --typeRoots ./node_modules/@types --types node",
    "format": "prettier --write {src,tests}/**/*.{js,ts}",
    "lint": "eslint {src,tests}/**/*.ts",
    "prepublishOnly": "npm run build",
    "serve": "serve -l 9000 docs",
    "start": "npm run build && npm run serve",
    "test": "jest --coverage",
    "update-docs": "cpy 'dist/signature_pad.umd.min.*' docs/js",
    "test:package": "node scripts/check-package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aniolpages/signature_pad-pressure.git"
  },
  "files": [
    "src",
    "dist",
    "docs"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/jest": "^30.0.0",
    "@types/node": "26.1.2",
    "cpy-cli": "7.0.0",
    "del": "^8.0.1",
    "del-cli": "7.0.0",
    "esbuild": "^0.28.1",
    "esbuild-plugin-umd-wrapper": "^3.0.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "17.8.0",
    "jest": "^30.4.2",
    "jest-canvas-mock": "^2.5.8",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.6",
    "semantic-release": "25.0.8",
    "serve": "^14.2.6",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "js"
    ],
    "moduleNameMapper": {
      "^\\./bezier\\.js$": "<rootDir>/src/bezier.ts",
      "^\\./point\\.js$": "<rootDir>/src/point.ts",
      "^\\./signature_event_target\\.js$": "<rootDir>/src/signature_event_target.ts",
      "^\\./throttle\\.js$": "<rootDir>/src/throttle.ts",
      "^\\./ink_preview\\.js$": "<rootDir>/src/ink_preview.ts"
    },
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "resources": "usable",
      "url": "http://localhost:3000/"
    },
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "setupFiles": [
      "jest-canvas-mock"
    ]
  },
  "release": {
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      "@semantic-release/git"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
